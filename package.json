{
  "name": "finanzas-personales",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Finanzas Personales (multiusuario)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate:sqlite-mysql": "node scripts/migrar-sqlite-a-mysql.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/controllers/**/*.js",
      "src/utils/**/*.js",
      "src/middlewares/**/*.js"
    ]
  },
  "keywords": [
    "finanzas",
    "personal-finance",
    "express",
    "sqlite",
    "sequelize"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mysql2": "^3.24.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
