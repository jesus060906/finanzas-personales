# ===== Base de datos =====
# Por defecto se usa SQLite (no requiere instalación ni configuración).
DB_DIALECT=sqlite
DB_STORAGE=data/finanzas.db

# ===== Sesión =====
SESSION_SECRET=cambia-este-secreto-en-produccion

# ===== Servidor =====
PORT=3000

# ===== Notas =====
# Opcional: migrar a MySQL como base final configurando:
#   DB_DIALECT=mysql
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_NAME=finanzas_personales
#   DB_USER=root
#   DB_PASSWORD=
#   DB_TIMEZONE=-04:00
# Para pruebas automatizadas (nunca tocan datos reales):
#   DB_DIALECT=sqlite
#   DB_STORAGE=:memory: